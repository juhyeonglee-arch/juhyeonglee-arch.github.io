---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft))
    .sort((a, b) => b.data.number - a.data.number);
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: all[i + 1] ?? all[0] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const facts = [
  ['연도', d.year], ['위치', d.location], ['용도', d.use], ['규모', d.area], ['상태', d.status],
  ['역할', d.role], ['크레딧', d.credits], ['사진', d.photographer],
].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary}>
  <main class="detail">
    <section class="head">
      <div class="titles">
        <span class="num muted">{pad(d.number)}</span>
        <h1>{d.title}</h1>
        {d.titleEn && <p class="muted en">{d.titleEn}</p>}
        {d.summary && <p class="muted">{d.summary}</p>}
      </div>
      <dl>{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>
    <Image class="wide" src={d.cover} alt={`${d.title} 대표 사진`} widths={[960, 1600, 2400]} sizes="100vw" />
    <section class="text"><div></div><div class="body"><Content /></div></section>
    {d.photos.length > 0 && (
      <section class="photos">{d.photos.map((ph, i) => (
        <Image src={ph} alt={`${d.title} 사진 ${i + 2}`} widths={[640, 1000, 1600]} sizes="(max-width: 960px) 100vw, 50vw" />
      ))}</section>
    )}
    {d.drawings.length > 0 && (
      <section class="drawings">
        <h2 class="muted">도면</h2>
        <div class="grid">{d.drawings.map((dr) => (
          <figure>
            <div class="frame"><Image src={dr.image} alt={dr.caption ?? `${d.title} 도면`} widths={[640, 1000, 1600]} sizes="(max-width: 960px) 100vw, 33vw" /></div>
            {dr.caption && <figcaption class="muted">{dr.caption}</figcaption>}
          </figure>
        ))}</div>
      </section>
    )}
    <nav class="pager" aria-label="프로젝트 이동">
      <a href={`${base}/`}>전체 목록</a>
      {next && next.id !== entry.id && <a href={`${base}/projects/${next.id}/`}>{pad(next.data.number)} {next.data.title} →</a>}
    </nav>
  </main>
</Base>

<style>
  .detail { display: flex; flex-direction: column; gap: 96px; padding: 64px var(--gutter) 0; }
  .head { display: flex; flex-wrap: wrap; gap: 48px 96px; }
  .titles { flex: 1 1 320px; display: flex; flex-direction: column; gap: 8px; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; line-height: 1.3; text-wrap: balance; }
  .titles p { margin: 0; }
  dl { flex: 1 1 320px; margin: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 6px 24px; font-size: 13px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .wide { width: 100%; }
  .text { display: flex; flex-wrap: wrap; gap: 24px 96px; }
  .text > div:first-child { flex: 0 1 320px; }
  .body { flex: 1 1 480px; max-width: 640px; }
  .body :global(p) { margin: 0 0 16px; }
  .photos { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
  .photos :global(img) { width: 100%; }
  .drawings { display: flex; flex-direction: column; gap: 24px; }
  h2 { margin: 0; font-size: 13px; font-weight: 400; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .frame { border: 1px solid var(--line); padding: 16px; }
  figcaption { font-size: 12px; }
  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 24px; }
  .pager a { padding: 12px 0; }
</style>
