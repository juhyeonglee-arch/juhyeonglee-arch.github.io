---
// 프로젝트 상세 페이지 예시 틀. 실제 프로젝트를 올리면 같은 구성으로 채워져요.
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const facts = ['연도', '위치', '용도', '규모', '상태', '역할', '크레딧', '사진'];
---
<Base title="예시 프로젝트">
  <main class="detail">
    <section class="head">
      <div class="titles">
        <span class="num muted">01</span>
        <h1>[프로젝트명]</h1>
        <p class="muted">[한 줄 소개]</p>
      </div>
      <dl>{facts.map((k) => <><dt>{k}</dt><dd class="muted">[{k}]</dd></>)}</dl>
    </section>
    <div class="ph wide"><span>[대표 사진]</span></div>
    <section class="text"><div></div><div class="body">
      <p class="muted">[설명 글 1문단: 대지와 프로그램]</p>
      <p class="muted">[설명 글 2문단: 설계 개념]</p>
      <p class="muted">[설명 글 3문단: 재료와 디테일]</p>
    </div></section>
    <section class="photos">
      <div class="ph tall"><span>[사진 02]</span></div>
      <div class="ph tall"><span>[사진 03]</span></div>
    </section>
    <section class="drawings">
      <h2 class="muted">도면</h2>
      <div class="grid">
        {['배치도 1:500', '1층 평면도 1:200', '단면도 1:200'].map((c) => (
          <figure><div class="ph square"><span>[{c.replace(/ 1:\d+$/, '')}]</span></div><figcaption class="muted">{c}</figcaption></figure>
        ))}
      </div>
    </section>
    <nav class="pager" aria-label="프로젝트 이동"><a href={`${base}/`}>전체 목록</a></nav>
  </main>
</Base>

<style>
  .detail { display: flex; flex-direction: column; gap: 96px; padding: 64px var(--gutter) 0; }
  .head { display: flex; flex-wrap: wrap; gap: 48px 96px; }
  .titles { flex: 1 1 320px; display: flex; flex-direction: column; gap: 8px; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; line-height: 1.3; }
  .titles p { margin: 0; }
  dl { flex: 1 1 320px; margin: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 6px 24px; font-size: 13px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .ph { display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .wide { aspect-ratio: 3 / 2; }
  .tall { aspect-ratio: 4 / 5; }
  .square { aspect-ratio: 1 / 1; }
  .text { display: flex; flex-wrap: wrap; gap: 24px 96px; }
  .text > div:first-child { flex: 0 1 320px; }
  .body { flex: 1 1 480px; max-width: 640px; }
  .body p { margin: 0 0 16px; }
  .photos { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
  .drawings { display: flex; flex-direction: column; gap: 24px; }
  h2 { margin: 0; font-size: 13px; font-weight: 400; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  figcaption { font-size: 12px; }
  .pager { border-top: 1px solid var(--line); padding-top: 24px; }
  .pager a { display: inline-block; padding: 12px 0; }
</style>
