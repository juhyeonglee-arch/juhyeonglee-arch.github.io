---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('notes', ({ data }) => !data.draft && data.kind !== '단상');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const related = d.related ? await getEntry('projects', d.related) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (x: Date) => `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, '0')}.${String(x.getDate()).padStart(2, '0')}`;
---
<Base title={d.title} description={d.summary} current="notes">
  <article class="note">
    <header>
      <p class="meta muted"><span class="num">{fmt(d.date)}</span> · {d.kind}</p>
      <h1>{d.title}</h1>
    </header>
    {d.cover && <Image class="cover" src={d.cover} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 720px) 100vw, 960px" />}
    <div class="body"><Content /></div>
    <nav class="pager" aria-label="노트 이동">
      <a href={`${base}/notes/`}>노트 목록</a>
      {related && <a href={`${base}/projects/${related.id}/`}>관련 프로젝트: {related.data.title} →</a>}
    </nav>
  </article>
</Base>
<style>
  .note { padding: 64px var(--gutter) 0; display: flex; flex-direction: column; gap: 48px; }
  header { max-width: 640px; display: flex; flex-direction: column; gap: 8px; }
  .meta { margin: 0; font-size: 13px; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; line-height: 1.3; text-wrap: balance; }
  .cover { max-width: 960px; width: 100%; }
  .body { max-width: 640px; font-size: 15px; line-height: 1.8; }
  .body :global(p) { margin: 0 0 20px; }
  .body :global(img) { margin: 32px 0; }
  .body :global(blockquote) { margin: 24px 0; padding-left: 16px; border-left: 1px solid var(--ink); color: var(--muted); }
  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 24px; }
  .pager a { padding: 12px 0; }
</style>
