---
// 사색·탐구 노트 페이지 예시 틀. 실제 노트를 올리면 같은 구성으로 채워져요.
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="예시 노트" current="notes">
  <article class="note">
    <header>
      <p class="meta muted"><span class="num">[날짜]</span> · 사색</p>
      <h1>[제목]</h1>
    </header>
    <div class="ph"><span>[스케치 또는 사진 (선택)]</span></div>
    <div class="body">
      <p class="muted">[글 1문단: 무엇을 보았고, 무엇이 마음에 걸렸는지]</p>
      <p class="muted">[글 2문단: 그것을 건축의 언어로 다시 생각해 보기]</p>
      <p class="muted">[글 3문단: 아직 답하지 못한 질문]</p>
    </div>
    <nav class="pager" aria-label="노트 이동"><a href={`${base}/notes/`}>노트 목록</a><span class="muted">[관련 프로젝트 →]</span></nav>
  </article>
</Base>
<style>
  .note { padding: 64px var(--gutter) 0; display: flex; flex-direction: column; gap: 48px; }
  header { max-width: 640px; display: flex; flex-direction: column; gap: 8px; }
  .meta { margin: 0; font-size: 13px; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; line-height: 1.3; }
  .ph { max-width: 960px; aspect-ratio: 3 / 2; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .body { max-width: 640px; font-size: 15px; line-height: 1.8; }
  .body p { margin: 0 0 20px; }
  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 24px; }
  .pager a, .pager span { padding: 12px 0; }
</style>
