---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.number - a.data.number);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
// 첫 화면 영상 4개 (public/hero 폴더). 위 3칸 + 아래 전체 폭 프로세스 그래프
const heroClips = [
  { name: 'intro', label: '인트로: SHP 파일 하나로 등고선 모델 자동 생성' },
  { name: 'map', label: 'SHP 지도 위에 데이터가 쌓이는 장면' },
  { name: 'model', label: '3D 모델 제작 과정' },
  { name: 'graph', label: '프로세스 그래프' },
];
---
<Base overlayHeader>
  <section class="hero" aria-label="첫 화면: 작업 과정 영상">
    {heroClips.map((c) => (
      <div class:list={['clip', c.name, { seq: c.name !== 'graph' }]}>
        {c.name === 'graph'
          ? <video src={`${base}/hero/${c.name}.mp4`} poster={`${base}/hero/${c.name}.jpg`} autoplay muted loop playsinline preload="auto" aria-label={c.label}></video>
          : <video src={`${base}/hero/${c.name}.mp4`} poster={`${base}/hero/${c.name}.jpg`} muted playsinline preload="auto" aria-label={c.label}></video>}
      </div>
    ))}
  </section>
  <main class="projects">
    {projects.map((p) => (
      <a class="project" href={`${base}/projects/${p.id}/`}>
        <div class="pair">
          <div class="cell"><Image src={p.data.cover} alt={`${p.data.title} 사진`} widths={[640, 1000, 1400]} sizes="(max-width: 960px) 100vw, 50vw" /></div>
          <div class="cell drawing"><Image src={p.data.coverDrawing} alt={`${p.data.title} 도면`} widths={[640, 1000, 1400]} sizes="(max-width: 960px) 100vw, 50vw" /></div>
        </div>
        <div class="caption">
          <span class="num">{pad(p.data.number)}</span>
          <span class="title">{p.data.title}</span>
          <span class="muted">{p.data.location}</span>
          <span class="muted">{p.data.year}</span>
        </div>
      </a>
    ))}
  </main>
</Base>

<script>
  // 위 세 칸 영상을 왼쪽부터 차례로 재생하고, 마지막이 끝나면 처음으로 돌아가요.
  // 화면에 보이지 않는 칸(휴대폰에서 숨긴 칸)은 건너뛰어요.
  const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('.hero .clip.seq video'));
  const playable = vids.filter((v) => v.offsetParent !== null);
  const play = (k: number) => {
    const v = playable[k];
    v.currentTime = 0;
    v.play().catch(() => {});
  };
  playable.forEach((v, k) => v.addEventListener('ended', () => play((k + 1) % playable.length)));
  if (playable.length) play(0);
</script>

<style>
  /* 첫 화면: 흰 바탕 위에 영상 4개를 여백을 두고 배치. 위 3칸은 영상 전체가 보이게(contain) */
  .hero {
    height: 100vh; height: 100svh; min-height: 620px;
    box-sizing: border-box;
    padding: clamp(88px, 11vh, 120px) var(--gutter) clamp(32px, 6vh, 64px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: clamp(16px, 4vw, 72px);
    row-gap: clamp(24px, 5vh, 56px);
    background: var(--ground);
  }
  .clip { min-width: 0; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .clip video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .clip.graph { grid-column: 1 / -1; }
  .clip.graph video { height: auto; aspect-ratio: 3840 / 800; }
  @media (max-width: 960px) {
    .hero { height: auto; min-height: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto auto; }
    .clip.seq video { height: auto; aspect-ratio: 1080 / 1320; }
    .clip.graph video { height: auto; aspect-ratio: 3840 / 800; }
  }
  @media (max-width: 600px) {
    .hero { grid-template-columns: 1fr; padding-top: 96px; row-gap: 32px; }
    .clip.seq video { max-width: 420px; margin: 0 auto; }
  }
  .projects { display: flex; flex-direction: column; gap: 120px; padding: 120px var(--gutter) 0; }
  .project { display: flex; flex-direction: column; gap: 16px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; height: calc(100svh - 140px); min-height: 480px; }
  .cell { min-height: 0; background: var(--ground); }
  .cell.drawing { border: 1px solid var(--line); }
  /* 이미지 전체가 보이도록(contain). 남는 부분은 흰 여백 */
  .cell :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .cell.drawing :global(img) { padding: 24px; }
  .caption { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
  .title { font-weight: 500; }
  @media (max-width: 960px) {
    .pair { grid-template-columns: 1fr; height: auto; min-height: 0; }
    .cell { aspect-ratio: 4 / 3; }
  }
</style>
