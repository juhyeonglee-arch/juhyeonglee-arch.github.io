---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.number - a.data.number);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
// 첫 화면 영상: public/hero 폴더의 <이름>.mp4 와 정지 화면 <이름>.jpg. 비워 두면('') 화면 높이만큼의 흰 여백으로 남아요.
// 실제 프로젝트가 하나도 없을 때만 보이는 예시 틀 (번호만 표시)
const examples = [3, 2, 1];
const heroVideo = 'main';
---
<Base overlayHeader>
  <section class:list={['hero', { 'has-video': heroVideo }]} aria-label="첫 화면">
    {heroVideo && (
      <video class="hero-video" src={`${base}/hero/${heroVideo}.mp4`} poster={`${base}/hero/${heroVideo}.jpg`} autoplay muted loop playsinline preload="auto" aria-label="Contour Model Generator: SHP 지도에서 레이저 시트, 등고선 모형까지 쌓이는 과정"></video>
    )}
  </section>
  <main class="projects">
    {projects.length === 0 && examples.map((n) => (
      <a class="project example" href={`${base}/projects/example/`}>
        <div class="pair">
          <div class="cell ph"><span>[렌더 또는 사진]</span></div>
          <div class="cell drawing ph"><span>[대표 도면]</span></div>
        </div>
        <div class="caption">
          <span class="num">{pad(n)}</span>
          <span class="title">[프로젝트명]</span>
          <span class="muted">[위치]</span>
          <span class="muted">[연도]</span>
        </div>
      </a>
    ))}
    {projects.map((p) => (
      <a class="project" href={`${base}/projects/${p.id}/`}>
        <div class="pair">
          <div class="cell"><Image src={p.data.cover} alt={`${p.data.title} 사진`} widths={[640, 1000, 1400]} sizes="(max-width: 960px) 100vw, 50vw" /></div>
          <div class="cell drawing"><Image src={p.data.coverDrawing} alt={`${p.data.title} 도면`} widths={[640, 1000, 1400]} sizes="(max-width: 960px) 100vw, 50vw" /></div>
        </div>
        <div class="caption">
          <span class="num">{pad(p.data.number)}</span>
          <span class="title">{p.data.title}</span>
          <span class="muted">{p.data.location}</span>
          <span class="muted">{p.data.year}</span>
        </div>
      </a>
    ))}
  </main>
</Base>

<style>
  /* 첫 화면: 화면 전체 크기. 영상은 잘리지 않게(contain) 흰 바탕 위에 놓여요 */
  .hero { height: 100vh; height: 100svh; min-height: 560px; background: var(--ground); overflow: hidden; }
  .hero-video { width: 100%; height: 100%; object-fit: contain; display: block; background: var(--ground); }
  @media (max-width: 720px) {
    .hero.has-video { height: auto; min-height: 0; padding-top: 72px; }
    .hero-video { height: auto; aspect-ratio: 16 / 9; }
  }
  .ph { display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .projects { display: flex; flex-direction: column; gap: 120px; padding: 120px var(--gutter) 0; }
  .project { display: flex; flex-direction: column; gap: 16px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; height: calc(100svh - 140px); min-height: 480px; }
  .cell { min-height: 0; background: var(--ground); }
  .cell.drawing { border: 1px solid var(--line); }
  /* 이미지 전체가 보이도록(contain). 남는 부분은 흰 여백 */
  .cell :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .cell.drawing :global(img) { padding: 24px; }
  .caption { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
  .title { font-weight: 500; }
  @media (max-width: 960px) {
    .pair { grid-template-columns: 1fr; height: auto; min-height: 0; }
    .cell { aspect-ratio: 4 / 3; }
  }
</style>
