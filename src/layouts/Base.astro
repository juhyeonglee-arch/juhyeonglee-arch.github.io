---
import { SITE } from '../site';
interface Props { title?: string; description?: string; overlayHeader?: boolean; current?: 'projects' | 'photos' | 'about' }
const { title, description = SITE.description, overlayHeader = false, current = 'projects' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { key: 'projects', label: '프로젝트', href: `${base}/` },
  { key: 'photos', label: '사진', href: `${base}/photos/` },
  { key: 'about', label: '소개', href: `${base}/about/` },
];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · ${SITE.name}` : SITE.name}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans+KR:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class:list={['site-header', { overlay: overlayHeader }]}>
    <a class="name box" href={`${base}/`}>{SITE.name}</a>
    <nav class="box" aria-label="주 메뉴">
      {nav.map((n) => <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </header>
  <slot />
  <footer class="site-footer">
    <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <span class="links">{SITE.links.map((l) => <a href={l.href}>{l.label}</a>)}</span>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --ground: #ffffff;
    --ink: #111111;
    --muted: #5f5f5c;
    --line: #d6d6d2;
    --placeholder: #ebebe8;
    --font-body: 'IBM Plex Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    --font-num: 'IBM Plex Mono', ui-monospace, monospace;
    --gutter: 48px;
    /* 레이아웃: 흰 바탕, 작은 글자, 큰 이미지. 한 화면에 한 프로젝트 */
  }
  @media (max-width: 720px) { :root { --gutter: 20px; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--ground); color: var(--ink); }
  body { font-family: var(--font-body); font-size: 14px; line-height: 1.6; }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: var(--muted); }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  img { max-width: 100%; height: auto; display: block; }
  .num { font-family: var(--font-num); font-size: 13px; font-variant-numeric: tabular-nums; }
  .muted { color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
<style>
  .site-header {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
    gap: 16px; padding: 24px var(--gutter);
  }
  .site-header.overlay { position: absolute; top: 0; left: 0; right: 0; z-index: 2; }
  .box { background: var(--ground); }
  .name { font-size: 15px; font-weight: 500; letter-spacing: 0.02em; padding: 10px 14px; margin-left: -14px; }
  .overlay .name { margin-left: 0; }
  nav { display: flex; gap: 24px; padding: 0 14px; }
  nav a { padding: 12px 0; }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .site-footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px;
    padding: 64px var(--gutter); color: var(--muted); font-size: 13px;
  }
  .links { display: flex; gap: 16px; }
  .links a, .mail { color: var(--muted); }
</style>
